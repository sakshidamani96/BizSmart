# BizSmart frontend configuration (copy to .env.local for local development)
#
# VITE_API_BASE_URL decides where the backend is:
#   (empty)                              -> offline demo mode, data lives only in the browser
#   /                                    -> same origin. Used on Render (the backend serves this UI)
#                                           and locally together with the Vite dev proxy (vite.config.js)
#   https://bizsmart-backend.onrender.com -> a separately hosted backend
VITE_API_BASE_URL=/
